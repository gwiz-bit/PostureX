# Environment secrets — never commit; keep only the .env.example templates
.env
.env.local

# Server access guide (SSH key path, DB password, deploy commands) — real
# credentials, must never reach git even if this repo ever goes public.
#
# Both paths are listed on purpose: the real file has been sitting at the repo
# root, where the `docs/` rule does not match it — `git status` listed it as
# untracked, so a single `git add .` would have pushed the DB password.
docs/DEPLOY_SERVER.md
/DEPLOY_SERVER.md

# SSH private keys (e.g. the sshkey-*.pem downloaded from Cloudfly). A leaked
# key means losing the whole server, and once committed it must be treated as
# leaked even if deleted right after — git history keeps it. Matched by
# extension so it does not depend on anyone remembering a naming convention.
*.pem
*.key

# Claude Code
.claude/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build output (regenerated on every build, machine-specific —
# tracking it just causes noisy merge conflicts with no real content)
/android/build/
/android/app/build/
