<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình mạng cho BẢN PHÁT HÀNH: chỉ cho phép HTTPS.

  Server thật chạy sau domain HTTPS (api.posturex1.com, Nginx + Let's Encrypt),
  nên không còn ngoại lệ HTTP nào. Trước đây file này liệt kê IP trần của VPS
  cho phép cleartext; đã xoá theo đúng ghi chú cũ "khi có HTTPS thì xoá hẳn
  khối này" — còn ngoại lệ nào là còn chỗ để hạ cấp về HTTP.

  Bản DEBUG không dùng file này: nó bị thay bởi
  android/app/src/debug/res/xml/network_security_config.xml, nơi cho phép mọi
  địa chỉ để ai chạy backend local ở IP LAN nào cũng được.

  ⚠️ Đổi sang một server chỉ có HTTP thì app sẽ không gọi được ("Cleartext HTTP
  traffic ... not permitted") — hãy dựng HTTPS thay vì thêm ngoại lệ vào đây.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
